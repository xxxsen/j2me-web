{
  "schemaVersion": 1,
  "packageName": "j2me-web",
  "packageVersion": "0.2.2",
  "publicApiVersion": 1,
  "admissionStatus": "CANDIDATE",
  "adapter": {
    "adapterKind": "J2ME_MINIJVM_WEB",
    "adapterId": "j2me-minijvm-web",
    "adapterAbi": "j2me-rms",
    "checkpointFormat": "j2me-rms-bundle-v1",
    "checkpointSemantics": "RMS_FILE_TREE",
    "capabilities": {
      "pause": true,
      "screenshot": true,
      "checkpoint": true,
      "contentSources": ["J2ME_JAR_V1"],
      "standardGamepad": true,
      "virtualKeyInput": true,
      "virtualKeyActions": ["UP", "DOWN", "LEFT", "RIGHT", "FIRE", "SOFT_LEFT", "SOFT_RIGHT", "DIGIT_0", "DIGIT_1", "DIGIT_2", "DIGIT_3", "DIGIT_4", "DIGIT_5", "DIGIT_6", "DIGIT_7", "DIGIT_8", "DIGIT_9", "STAR", "POUND"],
      "compatibilityProfiles": true,
      "frameCounter": true,
      "audioCodecs": ["MIDI", "WAV", "PCM", "AMR-NB", "AMR-WB", "AAC", "MP3"],
      "validationProbes": [
        "J2ME_INPUT_V1",
        "J2ME_KEY_STATE_V1",
        "J2ME_GC_V1",
        "J2ME_MEDIA_V1",
        "J2ME_3D_V1"
      ],
      "videoScalingModes": ["INTEGER_NEAREST", "SHARP_FIT", "SCALE2X"],
      "volume": true
    }
  },
  "core": {
    "id": "j2me-midp",
    "family": "J2ME",
    "generation": "MIDP",
    "gameCompatibilityLine": "j2me-jar-v1",
    "saveAbi": "j2me-rms-v1",
    "readableSaveAbis": ["j2me-rms-v1"]
  },
  "limits": {
    "maximumJarBytes": 134217728,
    "maximumCheckpointBytes": 2097152
  },
  "assets": [
    "runtime.js",
    "runtime.wasm",
    "runtime.data",
    "runtime.worker.js",
    "audio-transcoder.wasm",
    "audio-transcoder.glue.js",
    "audio-transcoder.worker.js",
    "runtime-api.js",
    "runtime-controller.js",
    "checkpoint-codec.js",
    "audio-policy.js",
    "input-probe.js",
    "key-state-probe.js",
    "gc-probe.js",
    "graphics-probe.js",
    "video-scaling.js",
    "compatibility-profiles.js",
    "virtual-keypad.js",
    "media-transcoder.js"
  ]
}
