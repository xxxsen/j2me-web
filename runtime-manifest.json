{
  "schemaVersion": 1,
  "packageName": "j2me-web",
  "packageVersion": "0.2.2",
  "publicApiVersion": 1,
  "admissionStatus": "CANDIDATE",
  "adapter": {
    "adapterKind": "J2ME_MINIJVM_WEB",
    "adapterId": "j2me-minijvm-web",
    "adapterAbi": "j2me-rms",
    "checkpointFormat": "j2me-rms-bundle-v1",
    "checkpointSemantics": "RMS_FILE_TREE",
    "capabilities": {
      "pause": true,
      "screenshot": true,
      "checkpoint": true,
      "contentSources": ["J2ME_JAR_V1"],
      "standardGamepad": true,
      "frameCounter": true,
      "validationProbes": ["J2ME_INPUT_V1", "J2ME_GC_V1"],
      "videoScalingModes": ["INTEGER_NEAREST", "SHARP_FIT", "SCALE2X"],
      "volume": false
    }
  },
  "core": {
    "id": "j2me-midp",
    "family": "J2ME",
    "generation": "MIDP",
    "gameCompatibilityLine": "j2me-jar-v1",
    "saveAbi": "j2me-rms-v1",
    "readableSaveAbis": ["j2me-rms-v1"]
  },
  "limits": {
    "maximumJarBytes": 134217728,
    "maximumCheckpointBytes": 2097152
  },
  "assets": [
    "runtime.js",
    "runtime.wasm",
    "runtime.data",
    "runtime.worker.js",
    "runtime-api.js",
    "runtime-controller.js",
    "checkpoint-codec.js",
    "audio-policy.js",
    "input-probe.js",
    "gc-probe.js",
    "video-scaling.js"
  ]
}
